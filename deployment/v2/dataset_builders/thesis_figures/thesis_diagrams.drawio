          <mxGeometry x="310" y="440" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="o3" value="Gradient clipping&#xa;Max norm = 1.0&#xa;(was 2.0 in v15)" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="440" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="o4" value="Early stopping&#xa;Patience = 20 epochs&#xa;Monitor: val_loss" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="830" y="440" width="240" height="70" as="geometry"/>
        </mxCell>

        <!-- Loss row -->
        <mxCell id="l_title" value="Loss functions" style="text;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="540" width="1070" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="l1" value="Azimuth — cosine distance  (v16 NEW)&#xa;L_az = 1 − (sin_p·sin_t + cos_p·cos_t)&#xa;Correct circular loss, no bias near ±180°&#xa;Weight: ×2" style="rounded=1;fillColor=#FAECE7;strokeColor=#993C1D;fontColor=#4A1B0C;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="580" width="380" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="Distance — focal SmoothL1  (v16 improved)&#xa;L_dist = SmoothL1(pred, target) × (1 + target.clamp(0,1))&#xa;Up-weights hard examples (far drones, low SNR)&#xa;Weight: ×1" style="rounded=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="450" y="580" width="380" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="l3" value="Height — focal SmoothL1&#xa;Same structure as distance loss&#xa;Weight: ×0.7" style="rounded=1;fillColor=#E6F1FB;strokeColor=#185FA5;fontColor=#042C53;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="850" y="580" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="total" value="Total loss = 2 × L_az  +  1 × L_dist  +  0.7 × L_ht" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="700" width="670" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

