          <mxGeometry x="740" y="280" width="360" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ib3" value="Linear 128→64 · BatchNorm1d · ReLU" style="rounded=1;fillColor=#CECBF6;strokeColor=#534AB7;fontColor=#26215C;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="330" width="360" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ib4" value="Output: 64-d vector" style="rounded=1;fillColor=#CECBF6;strokeColor=#534AB7;fontColor=#26215C;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="380" width="360" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ib_note" value="v15 was: Linear(3→32)→ReLU→Linear(32→32)→ReLU → 32-d" style="text;fontSize=10;fontColor=#888780;align=center;" vertex="1" parent="1">
          <mxGeometry x="740" y="440" width="360" height="20" as="geometry"/>
        </mxCell>
