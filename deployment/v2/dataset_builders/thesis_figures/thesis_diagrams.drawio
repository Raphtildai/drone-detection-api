        <mxCell id="ib" value="IPD branch  (v16 — redesigned)" style="rounded=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#26215C;fontSize=13;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="720" y="190" width="400" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="ib1" value="Linear 4→64 · BatchNorm1d · ReLU · Dropout(0.2)" style="rounded=1;fillColor=#CECBF6;strokeColor=#534AB7;fontColor=#26215C;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="230" width="360" height="40" as="geometry"/>
