        </mxCell>

        <!-- ── Loss boxes ── -->
        <mxCell id="l1" value="Azimuth loss  (v16)&#xa;L_az = 1 − (sin_p·sin_t + cos_p·cos_t)&#xa;Cosine distance — circular-correct" style="rounded=1;fillColor=#FAECE7;strokeColor=#993C1D;fontColor=#4A1B0C;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="750" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="Dist + height loss  (unchanged)&#xa;SmoothL1(pred, target)&#xa;× focal weight (1 + target.clamp(0,1))" style="rounded=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#04342C;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="840" y="750" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="l3" value="Total = 2 × L_az  +  1 × L_dist  +  0.7 × L_ht" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="840" width="570" height="40" as="geometry"/>
