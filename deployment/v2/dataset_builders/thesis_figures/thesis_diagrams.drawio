        <mxCell id="me1" value="Conv2d 3→32 · BatchNorm · ReLU · MaxPool2d" style="rounded=1;fillColor=#B5D4F4;strokeColor=#185FA5;fontColor=#042C53;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="230" width="360" height="40" as="geometry"/>
