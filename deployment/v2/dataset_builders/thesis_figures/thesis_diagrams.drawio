        <mxCell id="cat" value="Concatenate  [4096-d mel  ‖  64-d IPD]  =  4160-d fused vector" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="570" width="670" height="50" as="geometry"/>
